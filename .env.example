# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# Database passwords for the MySQL container (any long random strings).
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Signs the login cookie. Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Sign in with GitHub: register an OAuth app at https://github.com/settings/developers
#   Homepage URL:               http://localhost:8000
#   Authorization callback URL: http://localhost:8000/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Google (optional): https://console.cloud.google.com/apis/credentials
#   OAuth client ID, type "Web application", redirect URI http://localhost:8000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A "Pretend (dev)" sign-in button for trying things without an OAuth app.
# Local only: never turn this on for a server other people can reach.
DEV_LOGIN=false

# For a real server later: the public address, and true once it's served over https.
PUBLIC_URL=
COOKIE_SECURE=false
